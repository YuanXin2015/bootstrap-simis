{
  "title": "Bootstrap",
  "subtitle": "Methods in theoretical physics",
  "year": 2026,
  "overview": [
    "A workshop on bootstrap and related non-perturbative methods, bringing together researchers in quantum field theory, string theory, quantum gravity, and quantum information.",
    "Through talks and informal discussions, we will explore how symmetry, unitarity, positivity, crossing symmetry, and analyticity constrain physical theories. The workshop connects analytic insights, numerical techniques, and exact results, with space for contributions from postdocs and students."
  ],
  "themes": [
    "Conformal bootstrap",
    "Scattering amplitudes & S-matrix bootstrap",
    "Quantum mechanics & matrix models",
    "Integrability & exact methods",
    "Holography & quantum information",
    "Numerical optimization & AI-assisted methods"
  ],
